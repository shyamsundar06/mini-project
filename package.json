{
  "name": "intelligent-tourism-platform",
  "version": "1.0.0",
  "description": "Intelligent Tourism Management Platform with Multi-Agent AI, Live GPS Map, Voice Assistant, and SOS Emergency System",
  "main": "api/index.js",
  "scripts": {
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "seed": "node -e \"require('./backend/config/db').initDb()\"",
    "vercel-build": "npm install --prefix frontend && npm run build --prefix frontend"
  },
  "dependencies": {
    "@google/genai": "*",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0"
  }
}
